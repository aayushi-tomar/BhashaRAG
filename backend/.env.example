# Required: free Gemini API key (no credit card) from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: only needed for voice output
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional: pick a Sarvam voice (bulbul:v3): shubh, priya, ritu, aditya, neha, rahul, pooja ...
SARVAM_SPEAKER=shubh

# Optional: lighter reranker if the default (~2 GB) is too slow on your laptop
# RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
